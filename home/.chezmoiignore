{{ if not (lookPath "herdr") }}
# herdr Claude Code skill: generated by running `herdr --skill`, so it can only
# render where herdr is on PATH — every nix host, but not Windows. Also skipped
# on the first apply of a fresh host: the nix profile is created by before_03,
# after chezmoi's own PATH is fixed, so herdr isn't resolvable until the next
# run. Skipping beats failing the whole apply on a missing binary.
.claude/skills/herdr
{{ end }}

