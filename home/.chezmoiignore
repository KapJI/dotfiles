{{ if (index . "is_container" | default false) }}
# Ephemeral Coder/CI container: skip installer scripts (apt/desktop repos +
# age-key decryption) and all SSH material (the encrypted ssh config would need
# an age key we don't ship into workspaces). Git identity comes from Coder's
# git-config module, GitHub auth from Coder external auth. Placed last so these
# ignores win over the pubkey re-includes above.
.chezmoiscripts/**
# Exception: the nix-profile sync. The workspace bind-mounts the host's /nix, so
# build this user's tool profile from packages.yaml against that shared store
# (reusing already-built paths). nix install / upgrade / GC stay ignored — nix
# comes from the mount and the container must never mutate the host's store.
!.chezmoiscripts/unix/03-nix-profile-sync.sh
# Exception: npm packages. agent-tty drives TUIs, which is exactly what an
# agent workspace needs; the container has its own writable ~/.npm prefix.
!.chezmoiscripts/unix/75-install-npm-packages.sh
# Exception: agent plugins. The whole point of declaring them is that a rebuilt
# workspace comes back with the same plugin set as the laptop.
!.chezmoiscripts/unix/76-install-agent-plugins.sh
# Exception: the login-shell switch. The image ships bash, and `ssh <workspace>
# <cmd>` runs the login shell — bash gets no nix profile here, zsh does (see
# dot_zshenv.tmpl's is_container branch), so remote tooling needs zsh.
!.chezmoiscripts/unix/91-set-zsh-shell.sh
# Exception: the Coder git SSH key fetch. Without it a workspace has no signer
# at all, and it is the one piece of SSH material a workspace can obtain by
# itself (from the agent API, no age key involved).
!.chezmoiscripts/unix/04-coder-gitssh-key.sh
.ssh/**
# nvim's lazy.nvim rewrites lazy-lock.json in place when plugins install/update
# in the workspace; let it own the lock here so apply doesn't fight that drift.
.config/nvim/lazy-lock.json
{{ end }}
