{{- /*
  Render a single ssh-agent-loaded public key whose comment ends with .name.
  Fails loudly (halting `chezmoi apply`) when:
    - ssh-add -L returns no keys (agent unreachable, empty, or stale socket)
    - no loaded key matches the requested name suffix
  The previous version silently rendered empty in either case, which once
  caused chezmoi to write empty pubkey files on a host where the tmux
  session's SSH_AUTH_SOCK pointed at a dead socket.
*/ -}}
{{- $name := .name -}}
{{- /* Tolerate ssh-add's non-zero exit (agent not running, unreachable socket, or
       no identities) so `output` doesn't abort with a cryptic "exit status 2";
       the empty-check below then fails with an actionable message. sh isn't on
       Windows, so only wrap elsewhere. */ -}}
{{- /* .chezmoi isn't in scope here (this sub-template is called with a bare
       dict), so detect Windows via its OS env var rather than .chezmoi.os. */ -}}
{{- $output := "" -}}
{{- if eq (env "OS") "Windows_NT" -}}
{{-   $output = output "ssh-add" "-L" | trim -}}
{{- else -}}
{{-   $output = output "sh" "-c" "ssh-add -L 2>/dev/null || true" | trim -}}
{{- end -}}
{{- if eq $output "" -}}
{{-   fail (printf "ssh-add -L returned no keys; cannot render pubkey %q. Ensure the SSH agent is running (on macOS, the 1Password app must be open with SSH agent enabled — it stops after an app update), SSH_AUTH_SOCK is reachable, and the agent has the needed key loaded." $name) -}}
{{- end -}}
{{- $found := "" -}}
{{- range $output | splitList "\n" -}}
{{-   $line := trimSuffix "\r" . -}}
{{-   if hasSuffix $name $line -}}
{{-     $found = $line -}}
{{-   end -}}
{{- end -}}
{{- if eq $found "" -}}
{{-   fail (printf "no key with comment suffix %q found in ssh-agent. Loaded keys:\n%s" $name $output) -}}
{{- end -}}
{{ $found }}
