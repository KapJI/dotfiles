#!/usr/bin/env bash
# Coder workspace: make the Coder git SSH key available for signing commits.
#
# The account signer (1Password's op-ssh-sign) doesn't exist in a workspace, but
# Coder already holds a per-account git SSH key, and `coder gitssh` — which the
# workspace wires into GIT_SSH_COMMAND — authenticates GitHub pushes with it.
# That key is registered on GitHub for signing too, so reusing it means there is
# nothing to enrol per workspace: a rebuilt one just fetches it again.
#
# gitssh only materialises the key in a temp file for the length of one ssh
# call, so pull it from the same agent endpoint gitssh uses. That is a plain GET
# with the agent token, which any process in the workspace can already make;
# what is new here is only that the copy persists (0600, on the home volume).
#
# A `before_` script because dot_gitconfig.tmpl stats the public key to decide
# whether to enable signing at all. It writes ~/.ssh/allowed_signers itself
# rather than leaving that to a managed file: .chezmoiignore ignores .ssh/**
# wholesale in a container, and re-including one file there also resurfaces the
# pubkeys the block above deliberately hides (those render from `ssh-add -L`,
# which fails an apply in a workspace with no agent).
set -euo pipefail

# jq comes from the nix profile; chezmoi runs each script in a bare shell.
if [ -e /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
    # shellcheck disable=SC1091
    . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi

KEY="${HOME}/.ssh/coder_gitssh_key"
SIGNERS="${HOME}/.ssh/allowed_signers"

# Not a Coder workspace: nothing to fetch, and no key means signing stays off.
if [ -z "${CODER_AGENT_TOKEN:-}" ] || [ -z "${CODER_AGENT_URL:-}" ]; then
    exit 0
fi
if [ -s "${KEY}" ] && [ -s "${KEY}.pub" ] && [ -s "${SIGNERS}" ]; then
    exit 0
fi

if ! resp=$(curl -fsS --max-time 15 \
    -H "Coder-Session-Token: ${CODER_AGENT_TOKEN}" \
    "${CODER_AGENT_URL%/}/api/v2/workspaceagents/me/gitsshkey"); then
    echo "Could not fetch the Coder git SSH key; commits will be unsigned." >&2
    exit 0
fi

# $() strips the trailing newline the JSON string carries and printf puts back
# exactly one — ssh-keygen rejects a key file with a stray blank line.
priv=$(printf '%s' "${resp}" | jq -er '.private_key')
pub=$(printf '%s' "${resp}" | jq -er '.public_key')

mkdir -p "${HOME}/.ssh"
chmod 700 "${HOME}/.ssh"
umask 077
printf '%s\n' "${priv}" >"${KEY}"
printf '%s\n' "${pub}" >"${KEY}.pub"
chmod 600 "${KEY}"
chmod 644 "${KEY}.pub"

# Trust our own signature, or `git log --show-signature` can't verify the
# commits we just made (gpg.ssh.allowedSignersFile points here).
printf '%s %s\n' '{{ .git_email }}' "${pub}" >"${SIGNERS}"
chmod 644 "${SIGNERS}"

# Fail loudly on a truncated key instead of letting git report an unhelpful
# signing error on every single commit.
ssh-keygen -y -f "${KEY}" >/dev/null
