#!/usr/bin/env bash
# Sign commits in a Coder workspace with the Coder git SSH key: the same key
# `coder gitssh` pushes with, registered on GitHub for signing too, so nothing
# is enrolled per workspace. gitssh only materialises it for one ssh call, so
# refetch it from the agent endpoint gitssh uses — a plain GET any process here
# can already make; what is new is only that the copy persists (0600).
#
# `before_` because dot_gitconfig.tmpl stats the pubkey to decide on signing.
set -euo pipefail

# jq comes from the nix profile; chezmoi runs each script in a bare shell.
if [ -e /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
    # shellcheck disable=SC1091
    . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi

KEY="${HOME}/.ssh/coder_gitssh_key"

# Not a Coder workspace: nothing to fetch, and no key means signing stays off.
if [ -z "${CODER_AGENT_TOKEN:-}" ] || [ -z "${CODER_AGENT_URL:-}" ]; then
    exit 0
fi
if [ -s "${KEY}" ] && [ -s "${KEY}.pub" ]; then
    exit 0
fi

if ! resp=$(curl -fsS --max-time 15 \
    -H "Coder-Session-Token: ${CODER_AGENT_TOKEN}" \
    "${CODER_AGENT_URL%/}/api/v2/workspaceagents/me/gitsshkey"); then
    echo "Could not fetch the Coder git SSH key; commits will be unsigned." >&2
    exit 0
fi

# $() strips the trailing newline the JSON string carries and printf puts back
# exactly one — ssh-keygen rejects a key file with a stray blank line.
priv=$(printf '%s' "${resp}" | jq -er '.private_key')
pub=$(printf '%s' "${resp}" | jq -er '.public_key')

mkdir -p "${HOME}/.ssh"
chmod 700 "${HOME}/.ssh"
umask 077
printf '%s\n' "${priv}" >"${KEY}"
printf '%s\n' "${pub}" >"${KEY}.pub"
chmod 600 "${KEY}"
chmod 644 "${KEY}.pub"

# Fail loudly on a truncated key instead of letting git report an unhelpful
# signing error on every single commit.
ssh-keygen -y -f "${KEY}" >/dev/null
