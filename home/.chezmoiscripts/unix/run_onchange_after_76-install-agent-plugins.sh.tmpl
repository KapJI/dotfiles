#!/usr/bin/env bash

# Install AI-agent plugins from packages.yaml (`claude-plugin:` / `codex-plugin:`
# / `omp-plugin:` / `agy-plugin:` / `herdr-plugin:` / `agent-marketplace:` keys)
# for whichever of claude, codex, omp, agy and herdr exist on this host. Without this, plugins live
# only in each agent's own state dir — hand-installed per machine, never
# reaching a rebuilt container.
#
# An `after` script for the same reason as 75: the agents come from the nix
# profile that unix/before_03-nix-profile-sync builds, so in the before phase
# they would not exist yet on a fresh machine.
#
# Every step is non-fatal. A marketplace being unreachable, or one agent's
# registry being down, must never fail the whole `chezmoi apply`.
#
# Run weekly to pick up new plugin versions. claude `install` skips what is
# already there, so it refreshes its marketplaces and runs `update`. omp
# and agy install latest. codex is pinned to release tags, see its section.
# Current week: {{ div now.YearDay 7 }}, {{ now.Year }}

{{- $packages := joinPath .chezmoi.sourceDir ".data/packages.yaml" | include | fromYaml -}}
{{- $claudeMarkets := list -}}
{{- $claudePlugins := list -}}
{{- $codexPlugins := list -}}
{{- $ompPlugins := list -}}
{{- $herdrPlugins := list -}}
{{- $agyPlugins := list -}}
{{- range $packages -}}
    {{- $market := "" -}}
    {{- if hasKey . "agent-marketplace" -}}
        {{- $market = get . "agent-marketplace" -}}
    {{- end -}}
    {{- if hasKey . "claude-plugin" -}}
        {{- $claudePlugins = append $claudePlugins (get . "claude-plugin") -}}
        {{- if $market -}}{{- $claudeMarkets = append $claudeMarkets $market -}}{{- end -}}
    {{- end -}}
    {{- if hasKey . "codex-plugin" -}}
        {{- $codexPlugins = append $codexPlugins (dict "plugin" (get . "codex-plugin") "market" $market "trust" (get . "codex-trust-hooks")) -}}
    {{- end -}}
    {{- if hasKey . "omp-plugin" -}}
        {{- $ompPlugins = append $ompPlugins (get . "omp-plugin") -}}
    {{- end -}}
    {{- if hasKey . "agy-plugin" -}}
        {{- $agyPlugins = append $agyPlugins (get . "agy-plugin") -}}
    {{- end -}}
    {{- if hasKey . "herdr-plugin" -}}
        {{- $herdrPlugins = append $herdrPlugins (get . "herdr-plugin") -}}
    {{- end -}}
{{- end }}

set -e

. /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh 2>/dev/null || true

{{ if $claudePlugins }}
if command -v claude >/dev/null 2>&1; then
{{- range (uniq $claudeMarkets) }}
    claude plugin marketplace add {{ . | quote }} >/dev/null 2>&1 \
        || echo "claude: marketplace {{ . }} already configured or unreachable"
{{- end }}
    claude plugin marketplace update >/dev/null 2>&1 \
        || echo "claude: marketplace refresh failed"
    # --yes: accept the marketplace-declared install command; without it the
    # CLI waits for a confirmation nobody is here to give.
{{- range $claudePlugins }}
    claude plugin install --yes {{ . | quote }} >/dev/null 2>&1 \
        || echo "claude: {{ . }} already installed or unavailable"
    claude plugin update {{ . | quote }} >/dev/null 2>&1 \
        || echo "claude: {{ . }} update failed"
{{- end }}
else
    echo "claude not on PATH; skipping its plugins"
fi
{{ end }}

{{- if $codexPlugins }}
# codex upgrades every git marketplace to the tip of its ref at each startup,
# and an upgrade reinstalls its plugins, whose hooks then wait for review. So
# each marketplace is pinned to the commit of its newest release tag and moved
# here, weekly: startups find nothing to upgrade. The pin is the commit, not
# the tag name, because codex resolves a name with `git ls-remote <url> <name>`
# and takes the first match, and ponytail's release/vX.Y.Z branch matches
# before the tag: a tag pin would look outdated at every startup. Changing the
# ref takes a remove and add.
# `plugin add` runs only when the tag moved, since it re-fetches every time:
# ponytail's codex manifest installs the plugin from its `main` branch, not
# from the tag, so the tag only gates when an update is taken.
#
# codex_trust_hooks <field> <value> approves the new or changed hooks whose
# `hooks/list` <field> equals <value> (pluginId, or command), as the review
# screen would: `hooks/list` reports each hook's status and current hash, and
# `config/batchWrite` records the hash as trusted in config.toml. Only for
# plugins with `codex-trust-hooks: true` and our own AWF Writer guard; anything
# else goes to review.
codex_trust_hooks() {
    python3 - "$1" "$2" <<'EOF'
import json, os, subprocess, sys

# stderr: startup warnings (e.g. no bubblewrap sandbox); failures exit below.
server = subprocess.Popen(["codex", "app-server"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                          stderr=subprocess.DEVNULL, text=True)

def call(request_id, method, params):
    server.stdin.write(json.dumps({"id": request_id, "method": method, "params": params}) + "\n")
    server.stdin.flush()
    for line in server.stdout:
        message = json.loads(line)
        if message.get("id") == request_id:
            if "error" in message:
                sys.exit(f"{method}: {message['error']}")
            return message["result"]
    sys.exit(f"app-server exited during {method}")

try:
    call(1, "initialize", {"clientInfo": {"name": "chezmoi", "version": "1"}})
    server.stdin.write(json.dumps({"method": "initialized"}) + "\n")
    listing = call(2, "hooks/list", {"cwds": [os.environ["HOME"]]})
    approve = {
        hook["key"]: {"trusted_hash": hook["currentHash"]}
        for entry in listing["data"]
        for hook in entry["hooks"]
        if hook.get(sys.argv[1]) == sys.argv[2] and hook["trustStatus"] in ("untrusted", "modified")
    }
    if approve:
        edit = {"keyPath": "hooks.state", "value": approve, "mergeStrategy": "upsert"}
        call(3, "config/batchWrite", {"edits": [edit], "reloadUserConfig": True})
finally:
    server.stdin.close()
    server.wait()
EOF
}

if command -v codex >/dev/null 2>&1; then
{{- range $codexPlugins }}
{{- $name := index (splitList "@" .plugin) 1 }}
    url={{ printf "https://github.com/%s.git" .market | quote }}
    tag=$(git ls-remote --tags --refs --sort=-v:refname "$url" "v*" 2>/dev/null | sed -n '1s|.*refs/tags/||p')
    # An annotated tag lists its commit last, as <tag>^{}.
    sha=$(git ls-remote "$url" "refs/tags/$tag" "refs/tags/$tag^{}" 2>/dev/null | tail -1 | cut -f1)
    if [ -z "$tag" ] || [ -z "$sha" ]; then
        echo "codex: no release tag found for {{ .market }}; left as it is"
    else
        out=$(codex plugin marketplace add {{ .market | quote }} --ref "$sha" 2>&1) || case $out in
            # Configured at another ref (last week's tag), or an older codex's
            # snapshot that recorded no source at all.
            *"different source"*)
                codex plugin marketplace remove {{ $name | quote }} >/dev/null 2>&1 || true
                out=$(codex plugin marketplace add {{ .market | quote }} --ref "$sha" 2>&1) || true ;;
        esac
        case $out in
            *"Added marketplace"*)
                # The first upgrade after an add reinstalls the plugin once more
                # (later ones find it current), so take it now, before approving.
                if codex plugin add {{ .plugin | quote }} >/dev/null 2>&1 &&
                    codex plugin marketplace upgrade {{ $name | quote }} >/dev/null 2>&1; then
                    echo "codex: {{ .plugin }} updated to $tag"
{{- if .trust }}
                    codex_trust_hooks pluginId {{ .plugin | quote }} || echo "codex: could not approve {{ .plugin }} hooks"
{{- end }}
                else
                    echo "codex: {{ .plugin }} failed to install"
                fi ;;
            *"already added"*) ;;
            *) echo "codex: marketplace {{ .market }} at $tag failed: $out" ;;
        esac
    fi
{{- end }}
{{- if index . "is_container" | default false }}

    # The AWF Codex Writer guard that dot_codex/modify_hooks.json registers. It
    # only denies (pushes to main/master, force pushes, merges) and only in
    # sessions started with AWF_CODEX_WRITER=1, so approve it here rather than
    # leave Writers unguarded until someone reviews it in the TUI.
    # Hook entry hash: {{ include "dot_codex/modify_hooks.json.tmpl" | sha256sum }}
    codex_trust_hooks command {{ printf "python3 %s/.codex/awf-writer-guard.py" .chezmoi.homeDir | quote }} \
        || echo "codex: could not approve the AWF Writer guard hook"
{{- end }}
else
    echo "codex not on PATH; skipping its plugins"
fi
{{ end }}

{{- if $ompPlugins }}
if ! command -v omp >/dev/null 2>&1; then
    echo "omp not on PATH; skipping its plugins"
elif ! command -v bun >/dev/null 2>&1; then
    # `omp install` shells out to bun for npm specs and git refs alike. bun is
    # declared in packages.yaml, but on a fresh host the nix profile is built by
    # before_03 in this same apply, so warn rather than fail — the weekly re-run
    # picks it up.
    echo "bun not on PATH; skipping omp plugins (nix: bun should provide it)"
else
{{- range $ompPlugins }}
    omp install {{ . | quote }} >/dev/null 2>&1 \
        || echo "omp: {{ . }} already installed or unavailable"
{{- end }}
fi
{{ end }}

{{- if $agyPlugins }}
if command -v agy >/dev/null 2>&1; then
    # Takes a git URL and replaces an existing install, so this also updates.
{{- range $agyPlugins }}
    agy plugin install {{ . | quote }} >/dev/null 2>&1 \
        || echo "agy: {{ . }} failed to install"
{{- end }}
else
    echo "agy not on PATH; skipping its plugins"
fi
{{ end }}

{{- if $herdrPlugins }}
if command -v herdr >/dev/null 2>&1; then
    # `plugin install` clones with git over ssh, so in a Coder workspace it
    # authenticates through core.sshCommand in dot_gitconfig.tmpl.
    # Pinned, so skip what is already at its commit instead of re-cloning and
    # re-downloading the binary every week. A new pin installs over the old
    # one in place; no uninstall needed.
    installed=$(herdr plugin list 2>/dev/null || true)
{{- range $herdrPlugins }}
{{- $spec := splitList "@" . }}
    case $installed in
        *"[github:{{ index $spec 0 }}@{{ index $spec 1 }}]"*) ;;
        *) herdr plugin install {{ index $spec 0 | quote }} --ref {{ index $spec 1 | quote }} --yes >/dev/null 2>&1 \
            || echo "herdr: {{ . }} failed to install" ;;
    esac
{{- end }}
else
    echo "herdr not on PATH; skipping its plugins"
fi
{{ end }}
