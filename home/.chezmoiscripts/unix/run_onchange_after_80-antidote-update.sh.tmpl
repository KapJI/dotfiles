#!/usr/bin/env bash

{{ $antidote_plugins := joinPath .chezmoi.sourceDir "dot_config/zsh/dot_zsh_plugins.txt" -}}
# Antidote plugins hash: {{ include $antidote_plugins | sha256sum }}
# Run weekly. Current week: {{ div now.YearDay 7 }}, {{ now.Year }}

# Maintain the antidote plugin cache.
#
# Antidote and every bundle are pinned (the tool via an archive in
# .chezmoiexternal.toml, the bundles via pin:<sha>), so there is nothing to
# fetch: `antidote update` would only attempt its disabled self-update and skip
# every pinned bundle — a no-op that also exits non-zero — so it is
# intentionally NOT run. Instead this purges bundles dropped from the list, moves
# each patched plugin onto its pinned commit, and re-applies our fzf-tab /
# you-should-use patches. Version bumps are deliberate: run `bump-locks` (it
# commits).
#
# The pin checkout below is this script's job, not antidote's, because our
# patches live in the plugin's git worktree. `git checkout --detach <pin>`
# does NOT clobber a locally-modified file — it ABORTS ("Your local changes to
# the following files would be overwritten by checkout"). So after a
# `bump-locks` pin change, antidote's regen wedges permanently on the patched
# plugin and falls back to the previous static bundle. Once HEAD already IS the
# pin, antidote's own checkout changes no files and tolerates the patched
# worktree, which is what makes the patches survivable at all.
if [ -f "$HOME/.config/zsh/antidote/antidote.zsh" ]; then
    antidote_home="${ANTIDOTE_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/antidote}"
    [ -d "$antidote_home" ] || antidote_home="$HOME/Library/Caches/antidote"

    # Purge cached bundles no longer in dot_zsh_plugins.txt. antidote
    # update walks the on-disk cache, not the current plugin list, so
    # a removed plugin keeps getting fetched. If its upstream branch
    # was renamed/deleted (e.g. b4b4r07/enhancd's master), the fetch
    # errors on every run. Uses antidote's official `purge` command
    # so cache layout assumptions stay in upstream.
    zsh_plugins_txt="$HOME/.config/zsh/.zsh_plugins.txt"
    if [ -f "$zsh_plugins_txt" ]; then
        zsh -c '
            source ~/.config/zsh/antidote/antidote.zsh
            local -A expected
            local line bundle
            while IFS= read -r line; do
                bundle=${line%%[[:space:]]*}
                [[ -z $bundle || $bundle == \#* ]] && continue
                expected[$bundle]=1
            done < "'"$zsh_plugins_txt"'"
            antidote list 2>/dev/null | while read -r _path url; do
                bundle=${${url#https://github.com/}%.git}
                if [[ -z ${expected[$bundle]:-} ]]; then
                    echo "antidote: purging stale bundle: $bundle"
                    antidote purge "$bundle" </dev/null
                fi
            done
        '
    fi

    # Put a patched plugin on its pinned commit before patching it. Discards our
    # previous patch first (it is regenerated below), fetches only when the pin
    # object is genuinely absent — a `bump-locks` bump names a commit the local
    # clone has never seen, which surfaces as "fatal: unable to read tree".
    antidote_pin_checkout() {
        local repo=$1 bundle=$2 pin head
        [ -d "$repo/.git" ] || return 0
        [ -f "$zsh_plugins_txt" ] || return 0
        pin=$(sed -n "s|^${bundle}[[:space:]].*pin:\([0-9a-f]\{7,40\}\).*|\1|p" \
              "$zsh_plugins_txt" | head -1)
        [ -n "$pin" ] || return 0
        head=$(git -C "$repo" rev-parse HEAD 2>/dev/null)
        [ "$head" = "$pin" ] && return 0
        git -C "$repo" checkout --quiet -- . 2>/dev/null
        git -C "$repo" cat-file -e "${pin}^{commit}" 2>/dev/null \
            || git -C "$repo" fetch --quiet origin 2>/dev/null
        git -C "$repo" checkout --quiet --detach "$pin" 2>/dev/null \
            || echo "antidote: could not pin $bundle to ${pin:0:7}; patch left unapplied" >&2
    }

    # Every pinned bundle, not just the two patched below. `bump-locks` names a
    # commit no local clone has seen, and antidote's regen fails outright on it
    # ("pin commit ... not found" -> "bundle regen failed; keeping previous"),
    # so shells started between the new .zsh_plugins.txt landing and something
    # fetching run on the stale bundle. antidote does eventually fetch the SHA
    # itself, but only after erroring, and a herdrd restart respawns every pane
    # at once - turning a narrow window into a wall of identical errors. Doing
    # it here closes the window with the same apply that delivers the new pins.
    # ohmyzsh spans several lines but is one clone, hence sort -u.
    sed -n 's|^\([^#[:space:]][^[:space:]]*/[^[:space:]]*\)[[:space:]].*pin:[0-9a-f]\{7,40\}.*|\1|p' \
        "$zsh_plugins_txt" 2>/dev/null | sort -u | while IFS= read -r bundle; do
        antidote_pin_checkout "$antidote_home/$bundle" "$bundle"
    done

    # fzf-tab's active-group-style upstream supports only bold|underline|none.
    # Patch ftb-switch-group so the `bold` case emits bold + reverse video,
    # giving the active group a real background highlight (bold alone is
    # barely visible on most themes). Idempotent: grep guard short-circuits
    # once the patch is in place; re-applied automatically whenever antidote
    # refetches the lib file.
    fzf_tab_lib="$antidote_home/Aloxaf/fzf-tab/lib/ftb-switch-group"
    if [ -f "$fzf_tab_lib" ] && ! grep -qF "x1b[1;7m" "$fzf_tab_lib"; then
        python3 - "$fzf_tab_lib" <<'PY'
import pathlib, sys
p = pathlib.Path(sys.argv[1])
s = p.read_text()
subs = ((r"$'\x1b[1m'", r"$'\x1b[1;7m'"), (r"$'\x1b[22m'", r"$'\x1b[22;27m'"))
# Bail (loudly, non-fatally) rather than silently no-op if upstream renamed
# the SGR escapes: an unverified replace() would leave the active-group
# highlight quietly unpatched and nobody would notice until it stopped working.
missing = [old for old, _ in subs if old not in s]
if missing:
    print("warning: fzf-tab ftb-switch-group patch is stale — pattern(s) not "
          "found: %r; active-group highlight NOT applied" % missing, file=sys.stderr)
else:
    for old, new in subs:
        s = s.replace(old, new)
    p.write_text(s)
PY
    fi

    # you-should-use forks `tput` five times at source (once per shell) to
    # populate its NONE/BOLD/RED/YELLOW/PURPLE colour variables (~18ms
    # total here). We override YSU_MESSAGE_FORMAT (config.d/plugins/ysu.zsh)
    # so those variables are never used — swap the tput command
    # substitutions for the equivalent literal SGR escapes. Idempotent: the
    # grep guard short-circuits once `tput` is gone, and the patch is
    # re-applied automatically whenever antidote refetches the plugin.
    ysu_lib="$antidote_home/MichaelAquilina/zsh-you-should-use/you-should-use.plugin.zsh"
    if [ -f "$ysu_lib" ] && grep -qF 'tput sgr0' "$ysu_lib"; then
        python3 - "$ysu_lib" <<'PY'
import pathlib, sys
p = pathlib.Path(sys.argv[1])
s = p.read_text()
subs = [('%s="$(tput %s)"' % (name, tput), "%s=$'%s'" % (name, esc))
        for name, tput, esc in (
            ("NONE",   "sgr0",     r"\e[0m"),
            ("BOLD",   "bold",     r"\e[1m"),
            ("RED",    "setaf 1",  r"\e[31m"),
            ("YELLOW", "setaf 3",  r"\e[33m"),
            ("PURPLE", "setaf 5",  r"\e[35m"),
        )]
# Verify every pattern is present before rewriting; a silent partial patch
# would leave some tput forks in place (the ~18ms/shell cost we meant to kill)
# with no error to notice.
missing = [old for old, _ in subs if old not in s]
if missing:
    print("warning: zsh-you-should-use tput patch is stale — %d pattern(s) not "
          "found; leaving upstream tput forks in place" % len(missing), file=sys.stderr)
else:
    for old, new in subs:
        s = s.replace(old, new)
    p.write_text(s)
PY
    fi

    # zephyr recompiles $ZSH_COMPDUMP in a disowned background job and takes no
    # lock, while use-omz recompiles the same file guarded by a
    # "$ZSH_COMPDUMP.lock" mkdir. So the two race inside a single shell, and
    # every shell races every other one. zrecompile is NOT atomic despite
    # zephyr's comment saying so: it renames the *old* .zwc aside and writes the
    # new one in place, progressively, so a concurrent reader hits `zcompile -t`
    # on a half-written file and dies with "invalid zwc file". Restarting herdrd
    # respawns every pane at once, which is when this actually bites. Make
    # zephyr take the lock use-omz already uses, so one recompile wins and the
    # rest skip. Idempotent: the grep guard short-circuits once patched, and it
    # is re-applied whenever antidote refetches zephyr or a pin bump resets the
    # worktree.
    zephyr_completion="$antidote_home/mattmc3/zephyr/plugins/completion/completion.plugin.zsh"
    if [ -f "$zephyr_completion" ] && ! grep -qF 'ZSH_COMPDUMP}.lock' "$zephyr_completion"; then
        python3 - "$zephyr_completion" <<'PY'
import pathlib, sys
p = pathlib.Path(sys.argv[1])
s = p.read_text()
old = '  zrecompile -q -p "$ZSH_COMPDUMP" &!'
new = ('  { command mkdir "${ZSH_COMPDUMP}.lock" 2>/dev/null && '
       '{ zrecompile -q -p "$ZSH_COMPDUMP"; '
       'command rmdir "${ZSH_COMPDUMP}.lock" 2>/dev/null; } } &!')
# Bail loudly rather than silently no-op if upstream reworded the call: an
# unverified replace() would leave the race in place with nothing to notice.
if old not in s:
    print("warning: zephyr zrecompile patch is stale - call site not found; "
          "compdump recompile left unlocked", file=sys.stderr)
else:
    p.write_text(s.replace(old, new))
PY
    fi
fi
