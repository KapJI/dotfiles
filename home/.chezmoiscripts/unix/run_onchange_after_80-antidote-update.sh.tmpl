#!/usr/bin/env bash

{{ $antidote_plugins := joinPath .chezmoi.sourceDir "dot_config/zsh/dot_zsh_plugins.txt" -}}
# Antidote plugins hash: {{ include $antidote_plugins | sha256sum }}
# Run weekly. Current week: {{ div now.YearDay 7 }}, {{ now.Year }}

# Update antidote plugins.
#
# Both antidote itself and every bundle in .zsh_plugins.txt are pinned (the
# tool via an archive in .chezmoiexternal.toml, the bundles via pin:<sha>), and
# antidote skips pinned bundles during `antidote update` — so this run no
# longer rolls anything forward on its own (the self-update also no-ops with no
# .git). What it still does: purge stale bundles and re-apply the fzf-tab /
# you-should-use patches below. Version bumps are deliberate: run `bump-locks`
# (aliases.zsh), then commit; the new SHAs are checked out at the next shell
# (bundle regen) or on other hosts at the next apply.
#
# Force git/ssh into non-interactive mode. Antidote's git wrappers redirect
# stderr to /dev/null (antidote.zsh's git_fetch/git_pull), so any
# interactive prompt (SSH host-key confirmation, credential ask) would
# hang silently waiting on stdin. With these flags any such prompt fails
# fast with a visible error instead of an invisible deadlock.
#   GIT_TERMINAL_PROMPT=0       — git refuses to ask for usernames/passwords.
#   ssh BatchMode=yes           — ssh refuses to ask for passwords.
#   ssh StrictHostKeyChecking=accept-new — auto-accept never-seen-before
#                                  hosts (added to known_hosts), still
#                                  reject changed keys (MITM protection).
if [ -f "$HOME/.config/zsh/antidote/antidote.zsh" ]; then
    export GIT_TERMINAL_PROMPT=0
    export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new"

    # We patch files inside two plugin clones below (fzf-tab, you-should-use),
    # leaving their working trees dirty. Antidote updates via `git pull
    # --rebase`, which refuses to run against a dirty tree unless autostash is
    # on — and antidote only passes --autostash when ANTIDOTE_GIT_AUTOSTASH is
    # exactly "true". Without this, the weekly update fails the moment either
    # upstream gets a commit. With it, our patches are stashed across the
    # rebase and re-applied afterward (and re-patched below anyway).
    export ANTIDOTE_GIT_AUTOSTASH=true

    antidote_home="${ANTIDOTE_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/antidote}"
    [ -d "$antidote_home" ] || antidote_home="$HOME/Library/Caches/antidote"

    # Purge cached bundles no longer in dot_zsh_plugins.txt. antidote
    # update walks the on-disk cache, not the current plugin list, so
    # a removed plugin keeps getting fetched. If its upstream branch
    # was renamed/deleted (e.g. b4b4r07/enhancd's master), the fetch
    # errors on every run. Uses antidote's official `purge` command
    # so cache layout assumptions stay in upstream.
    zsh_plugins_txt="$HOME/.config/zsh/.zsh_plugins.txt"
    if [ -f "$zsh_plugins_txt" ]; then
        zsh -c '
            source ~/.config/zsh/antidote/antidote.zsh
            local -A expected
            local line bundle
            while IFS= read -r line; do
                bundle=${line%%[[:space:]]*}
                [[ -z $bundle || $bundle == \#* ]] && continue
                expected[$bundle]=1
            done < "'"$zsh_plugins_txt"'"
            antidote list 2>/dev/null | while read -r _path url; do
                bundle=${${url#https://github.com/}%.git}
                if [[ -z ${expected[$bundle]:-} ]]; then
                    echo "antidote: purging stale bundle: $bundle"
                    antidote purge "$bundle" </dev/null
                fi
            done
        '
    fi

    # Snapshot each plugin's checked-out commit BEFORE update so we can
    # detect whether anything actually changed. This runs weekly but most
    # weeks no plugin updates; we only invalidate the zsh compdump cache
    # when at least one plugin's HEAD commit moved.
    #
    # Hash the resolved commit SHA, NOT the .git/HEAD file: every plugin
    # is checked out on a branch, so HEAD is a symbolic ref
    # ("ref: refs/heads/master") whose bytes never change as commits
    # advance — hashing the file would compare equal every week and
    # silently skip invalidation.
    _antidote_head_snapshot() {
        find "$antidote_home" -maxdepth 3 -name .git -type d 2>/dev/null \
            | sort \
            | while IFS= read -r gitdir; do
                git --git-dir="$gitdir" rev-parse HEAD 2>/dev/null
            done | sha256sum
    }
    hash_before=$(_antidote_head_snapshot)

    if ! zsh -c 'source ~/.config/zsh/antidote/antidote.zsh; antidote update'; then
        echo "antidote update failed — likely an auth or host-key issue." >&2
        echo "Reproduce with stderr visible: antidote update" >&2
        exit 1
    fi

    hash_after=$(_antidote_head_snapshot)
    if [ "$hash_before" != "$hash_after" ]; then
        # At least one plugin moved. Invalidate compdump in case the
        # update added/removed completion files, and drop the static
        # bundle's .zwc so antidote.zsh regenerates it on next shell
        # against the updated plugin store.
        rm -f -- "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/"zcompdump*
        rm -f -- "$HOME/.config/zsh/.zsh_plugins.zsh.zwc"
    fi

    # fzf-tab's active-group-style upstream supports only bold|underline|none.
    # Patch ftb-switch-group so the `bold` case emits bold + reverse video,
    # giving the active group a real background highlight (bold alone is
    # barely visible on most themes). Idempotent: grep guard short-circuits
    # once the patch is in place; re-applied automatically whenever antidote
    # refetches the lib file.
    fzf_tab_lib="$antidote_home/Aloxaf/fzf-tab/lib/ftb-switch-group"
    if [ -f "$fzf_tab_lib" ] && ! grep -qF "x1b[1;7m" "$fzf_tab_lib"; then
        python3 - "$fzf_tab_lib" <<'PY'
import pathlib, sys
p = pathlib.Path(sys.argv[1])
s = p.read_text()
subs = ((r"$'\x1b[1m'", r"$'\x1b[1;7m'"), (r"$'\x1b[22m'", r"$'\x1b[22;27m'"))
# Bail (loudly, non-fatally) rather than silently no-op if upstream renamed
# the SGR escapes: an unverified replace() would leave the active-group
# highlight quietly unpatched and nobody would notice until it stopped working.
missing = [old for old, _ in subs if old not in s]
if missing:
    print("warning: fzf-tab ftb-switch-group patch is stale — pattern(s) not "
          "found: %r; active-group highlight NOT applied" % missing, file=sys.stderr)
else:
    for old, new in subs:
        s = s.replace(old, new)
    p.write_text(s)
PY
    fi

    # you-should-use forks `tput` five times at source (once per shell) to
    # populate its NONE/BOLD/RED/YELLOW/PURPLE colour variables (~18ms
    # total here). We override YSU_MESSAGE_FORMAT (config.d/plugins/ysu.zsh)
    # so those variables are never used — swap the tput command
    # substitutions for the equivalent literal SGR escapes. Idempotent: the
    # grep guard short-circuits once `tput` is gone, and the patch is
    # re-applied automatically whenever antidote refetches the plugin.
    ysu_lib="$antidote_home/MichaelAquilina/zsh-you-should-use/you-should-use.plugin.zsh"
    if [ -f "$ysu_lib" ] && grep -qF 'tput sgr0' "$ysu_lib"; then
        python3 - "$ysu_lib" <<'PY'
import pathlib, sys
p = pathlib.Path(sys.argv[1])
s = p.read_text()
subs = [('%s="$(tput %s)"' % (name, tput), "%s=$'%s'" % (name, esc))
        for name, tput, esc in (
            ("NONE",   "sgr0",     r"\e[0m"),
            ("BOLD",   "bold",     r"\e[1m"),
            ("RED",    "setaf 1",  r"\e[31m"),
            ("YELLOW", "setaf 3",  r"\e[33m"),
            ("PURPLE", "setaf 5",  r"\e[35m"),
        )]
# Verify every pattern is present before rewriting; a silent partial patch
# would leave some tput forks in place (the ~18ms/shell cost we meant to kill)
# with no error to notice.
missing = [old for old, _ in subs if old not in s]
if missing:
    print("warning: zsh-you-should-use tput patch is stale — %d pattern(s) not "
          "found; leaving upstream tput forks in place" % len(missing), file=sys.stderr)
else:
    for old, new in subs:
        s = s.replace(old, new)
    p.write_text(s)
PY
    fi
fi
