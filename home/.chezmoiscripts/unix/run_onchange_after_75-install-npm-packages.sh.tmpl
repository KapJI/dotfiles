#!/usr/bin/env bash

# Install global npm packages from packages.yaml (`npm:` key) into the
# ~/.npm prefix (~/.npm/bin is already on PATH via zsh config.d/path.zsh).
# The sole consumer of the `npm:` key on macOS and Linux alike; .chezmoiignore
# gates it to desktop + container, since the only thing it installs so far
# (agent-tty) has no business pulling a node toolchain onto a headless server.
#
# An `after` script deliberately: node comes from the nix profile, which
# unix/before_03-nix-profile-sync builds, so in the before phase node would not
# exist yet on a fresh machine.
#
# Run weekly (npm install -g always fetches latest).
# Current week: {{ div now.YearDay 7 }}, {{ now.Year }}

{{- $packages := joinPath .chezmoi.sourceDir ".data/packages.yaml" | include | fromYaml -}}
{{ $npm := list -}}
{{ range $packages -}}
    {{ if hasKey . "npm" -}}
        {{ $npm = append $npm (get . "npm") -}}
    {{ end -}}
{{ end }}

set -e

. /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh 2>/dev/null || true

if ! command -v node >/dev/null 2>&1; then
    echo "node not on PATH; skipping npm package install"
    exit 0
fi

# Explicit prefix: the nix node's default global prefix is its read-only
# store path.
npm_prefix="$HOME/.npm"

# Browsers come from nix below, not from playwright's postinstall download.
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

{{ range $npm -}}
npm install --global --prefix "$npm_prefix" "{{ . }}"
{{ end }}

# agent-tty renders screenshots and WebM through Playwright Chromium, but
# playwright's own downloaded build is a generic Linux binary that cannot start
# on a nix host ("libnspr4.so: cannot open shared object file"). Use nixpkgs'
# patched build from the flake instead -- pinned by the same flake.lock as
# everything else, and built here rather than installed into the nix profile so
# headless servers don't pay 423 MiB for a renderer they never run.
#
# Playwright resolves a browser by the revision *it* pins, which rarely matches
# nixpkgs'. Bridge the two: one real directory per pinned revision (playwright
# and `agent-tty doctor` both require a directory, not a symlink) whose contents
# link into the store. Both revisions are read at run time, so an agent-tty bump
# or a flake.lock bump re-links instead of silently breaking.
browsers_json="$npm_prefix/lib/node_modules/agent-tty/node_modules/playwright-core/browsers.json"

if [ -f "$browsers_json" ]; then
    # Build through an out-link so the store paths get a gcroot. In the
    # container /nix is a shared mount and the host's nix cannot see roots
    # under $HOME, so prefer the store's own per-user gcroot dir.
    #
    # Suffixed by hostname because every Coder workspace runs as the same user
    # against one shared store: a bare name lets whichever workspace applies
    # last overwrite the others' out-link, unrooting their browsers for the
    # next host GC. `id -un` because $USER is unset under docker exec and cron.
    link_dir="/nix/var/nix/gcroots/per-user/$(id -un)"
    mkdir -p "$link_dir" 2>/dev/null || link_dir="$HOME/.cache/agent-tty"
    mkdir -p "$link_dir"
    browsers_link="$link_dir/playwright-browsers-{{ .chezmoi.hostname }}"

    # Non-fatal: a build that fails offline must not fail the whole apply, and
    # it only costs screenshots -- snapshots, waits and the dashboard run on
    # the native libghostty-vt engine either way.
    if nix build --out-link "$browsers_link" \
        "path:$HOME/.config/nix-profile#playwright-browsers"; then
        nix_browsers=$(readlink -f "$browsers_link")

        # agent-tty is playwright's only consumer on these hosts, so the cache
        # is ours to rebuild; a symlink farm costs nothing to recreate. This
        # also reclaims what the old `playwright install chromium` left behind.
        case "$(uname -s)" in
            Darwin) cache="$HOME/Library/Caches/ms-playwright" ;;
            *)      cache="${XDG_CACHE_HOME:-$HOME/.cache}/ms-playwright" ;;
        esac
        rm -rf "$cache"

        for src in "$nix_browsers"/*; do
            [ -d "$src" ] || continue
            base=${src##*/}
            name=${base%-*}
            # On disk playwright writes chromium_headless_shell; browsers.json
            # names it chromium-headless-shell.
            rev=$(node -p "(require('$browsers_json').browsers.find(b => b.name === '$(echo "$name" | tr _ -)') || {}).revision || ''")
            [ -n "$rev" ] || continue
            mkdir -p "$cache/$name-$rev"
            ln -sfn "$src"/* "$cache/$name-$rev/"
        done
    else
        echo "note: playwright-browsers build failed; agent-tty screenshots" \
             "and WebM export stay unavailable until the next apply"
    fi
fi

"$npm_prefix/bin/agent-tty" doctor \
    || echo "agent-tty doctor reported problems (non-fatal)"
