#!/usr/bin/env bash

. /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh 2>/dev/null || true

# nvim-treesitter (main branch) compiles parsers by shelling out to the
# `tree-sitter` CLI, which chezmoi installs to ~/.local/bin (.chezmoiexternal.toml),
# NOT the nix profile. chezmoi runs this script with whatever PATH invoked it,
# which on a fresh machine need not include ~/.local/bin — and nix-daemon.sh
# above doesn't add it. Without this, every parser build fails with
# `ENOENT: 'tree-sitter'` and the work silently defers to the first interactive
# nvim launch. gcc for the compile comes from build-essential on the system PATH.
export PATH="$HOME/.local/bin:$PATH"

# Sync nvim plugins to the pinned lazy-lock.json + refresh treesitter parsers.
# Re-runs weekly (parser refresh; also re-pins plugins, healing any lazy-lock
# drift). Current week: {{ div now.YearDay 7 }}, {{ now.Year }}

# Drive parser installation from here rather than letting the plugin's startup
# config do it: nvim-treesitter's install() is async, so the config's fire-and-
# forget install() would be cut off by +qall (only the fastest parsers would
# finish before nvim exits, leaving the rest to compile on the first
# interactive launch). TS_PREINSTALL=1 makes treesitter.lua skip that startup
# install() so the explicit install():wait() below is the single, authoritative
# pass — and can't race a second install() in the same nvim instance.
export TS_PREINSTALL=1

# Migration cleanup: machines set up under the old nvim-treesitter master
# branch carry a tmux.so (+ revision + queries) that the main-branch registry
# doesn't know about. update() below then logs "Parser not available for
# language tmux" every run while trying to reconcile it. Remove the dead
# artifacts (parser, revision, queries) so get_installed() no longer reports
# tmux. Idempotent — a no-op once they're gone, and absent on fresh machines.
ts_site="${XDG_DATA_HOME:-$HOME/.local/share}/nvim/site"
rm -f "$ts_site/parser/tmux.so" "$ts_site/parser-info/tmux.revision"
rm -rf "$ts_site/queries/tmux"

# First pass: pin plugins to lazy-lock.json. Order matters: `restore` first,
# checking out every installed plugin to its locked commit (reverting any drift)
# WITHOUT rewriting the lock — then `install` to clone anything missing (on a
# fresh machine this is where nvim-treesitter lands on disk) at its locked
# commit. Deliberately NOT `Lazy! sync`, which *updates* past the lock and
# rewrites lazy-lock.json every run, drifting a chezmoi-managed file. And NOT
# install-before-restore: install rewrites the lock to the on-disk commit, so a
# drifted plugin would get re-pinned to its drifted commit before restore ran.
# Bump versions on purpose: `:Lazy update` then
# `chezmoi re-add ~/.config/nvim/lazy-lock.json` (mirrors bump-locks for nix).
nvim --headless "+Lazy! restore" "+Lazy! install" +qall

# Second pass: compile parsers and WAIT for them (install()/update() are
# nvim-treesitter async tasks; :wait() blocks until they finish).
#   install(<manifest>, {max_jobs=N}) — compile every manifest parser not yet
#     present, so a fresh `chezmoi apply` finishes the parsers HERE instead of
#     on the first interactive nvim (it no-ops already-installed parsers, so
#     repeat weekly runs are cheap). max_jobs caps concurrent downloads: the
#     default (100 → all ~50 at once) saturates the network and yields
#     corrupt/truncated tarballs ("Damaged tar archive", rename ENOENT). It
#     runs twice so a parser whose download flaked the first time is retried —
#     the second call no-ops everything already installed.
#   update() — refresh installed parsers to their latest revision (the weekly
#     job; install() alone never updates).
# The parser list is the single source of truth in lua/config/ts-parsers.lua,
# shared with the plugin config (lua/plugins/treesitter.lua).
nvim --headless "+lua local ts = require('nvim-treesitter'); local want = require('config.ts-parsers'); local opts = { summary = true, max_jobs = 4 }; ts.install(want, opts):wait(600000); ts.install(want, opts):wait(600000); ts.update({ summary = true }):wait(600000)" +qall
