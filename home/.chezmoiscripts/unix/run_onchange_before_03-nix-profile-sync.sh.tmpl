{{ if has .chezmoi.os (list "darwin" "linux") -}}
#!/usr/bin/env bash
set -euo pipefail

# Re-runs whenever packages.yaml or flake.lock content changes.
# packages.yaml hash: {{ include ".data/packages.yaml" | sha256sum }}
# flake.lock hash:    {{ include "dot_config/nix-profile/flake.lock" | sha256sum }}

. /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh 2>/dev/null || true

mkdir -p "$HOME/.config/nix-profile"
cp -f "{{ joinPath .chezmoi.sourceDir "dot_config/nix-profile/flake.lock" }}" \
    "$HOME/.config/nix-profile/flake.lock"

cat > "$HOME/.config/nix-profile/flake.nix" <<'NIXEOF'
{
  description = "Ruslan dotfiles CLI tools";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    # AI coding agents (claude-code, codex, omp, ...): rebuilt daily, and
    # published prebuilt to cache.numtide.com for every system we target —
    # fresher than nixpkgs, and omp isn't in nixpkgs at all.
    #
    # Deliberately no `inputs.nixpkgs.follows` here: overriding the inputs
    # changes every derivation hash and misses that cache, which for omp means
    # compiling its Rust engine locally (~16 min) on every host. The cache is
    # added by unix/02-nix-substituters.
    llm-agents.url = "github:numtide/llm-agents.nix";
  };

  outputs = { self, nixpkgs, llm-agents }:
    let
      systems = [ "aarch64-darwin" "x86_64-linux" "aarch64-linux" ];
      forAllSystems = nixpkgs.lib.genAttrs systems;

      defaultPaths = pkgs: system: with pkgs; [
{{- $packages := joinPath .chezmoi.sourceDir ".data/packages.yaml" | include | fromYaml }}
{{- range $packages }}
{{-   if hasKey . "llm-agents" }}
        llm-agents.packages.${system}.{{ get . "llm-agents" }}
{{-   end }}
{{- end }}
{{- range $packages }}
{{-   if hasKey . "nix" }}
        {{ get . "nix" }}
{{-   end }}
{{- end }}
      ];

      desktopExtras = pkgs: system: with pkgs; [
{{- range $packages }}
{{-   if hasKey . "nix-desktop" }}
        {{ get . "nix-desktop" }}
{{-   end }}
{{- end }}
      ];

      serverExtras = pkgs: system: with pkgs; [
{{- range $packages }}
{{-   if hasKey . "nix-server" }}
        {{ get . "nix-server" }}
{{-   end }}
{{- end }}
      ];

      mkProfile = system: extras:
        let pkgs = nixpkgs.legacyPackages.${system};
        in pkgs.buildEnv {
          name = "dotfiles-profile";
          paths = (defaultPaths pkgs system) ++ (extras pkgs system);
        };
    in {
      packages = forAllSystems (system: {
        default = mkProfile system serverExtras;     # Linux server (is_desktop=false)
        desktop = mkProfile system desktopExtras;    # macOS or Linux desktop

        # Chromium for agent-tty's PNG screenshot / WebM renderer. Playwright's
        # own downloaded build is a generic Linux binary that cannot start on a
        # nix host ("libnspr4.so: cannot open shared object file"); nixpkgs' is
        # patched to find its libraries. Deliberately NOT in either profile:
        # it is built on demand by unix/75-install-npm-packages.sh, so only the
        # hosts that actually run agent-tty pay for it. Headless shell only --
        # that is what `chromium.launch({headless: true})` runs -- plus ffmpeg
        # for WebM export: 423 MiB, against 2.1 GiB for the full browser set.
        playwright-browsers =
          nixpkgs.legacyPackages.${system}.playwright-driver.selectBrowsers {
            withChromium = false;
            withChromiumHeadlessShell = true;
            withFfmpeg = true;
            withFirefox = false;
            withWebkit = false;
          };
      });
    };
}
NIXEOF

profile_target="{{ if .is_desktop }}desktop{{ else }}default{{ end }}"

# Snapshot the resolved nix profile path BEFORE rebuild. Nix store
# paths are content-addressed, so identical inputs → identical paths.
# If the rebuild produces the same store path, completions didn't
# change and we shouldn't invalidate the compdump cache.
profile_before=$(readlink -f "$HOME/.nix-profile" 2>/dev/null || true)

# Build the new profile BEFORE removing the current entry. A network,
# evaluation, or build failure aborts here (set -e) while the live
# generation is still intact, instead of after the remove — which would
# otherwise leave the profile without our tool bundle until the next
# successful apply. The store path is cached, so `nix profile add` below
# just reuses it.
nix build --no-link "path:$HOME/.config/nix-profile#${profile_target}"

# Remove our previous entry before re-adding so a new flake content
# actually rebuilds (otherwise Nix short-circuits as "already installed
# at this priority" and packages.yaml additions silently drop on the
# floor). Older nix versions named the entry by path basename
# ("nix-profile"); newer versions name it by the flake attribute
# ("desktop"/"default"). Try both — at most one matches.
nix profile remove "${profile_target}" 2>/dev/null || true
nix profile remove nix-profile          2>/dev/null || true

nix profile add --priority 5 \
    "path:$HOME/.config/nix-profile#${profile_target}"

profile_after=$(readlink -f "$HOME/.nix-profile" 2>/dev/null || true)

# Only invalidate when the resolved store path actually changed.
# Catches the no-op case where packages.yaml's content hash flipped
# (e.g. comment edit) but the resulting derivation is identical.
if [ -n "$profile_after" ] && [ "$profile_before" != "$profile_after" ]; then
    rm -f -- "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/"zcompdump*
fi
{{- if index . "is_container" | default false }}

# This workspace bind-mounts the host's /nix. Nix registers the profile's gcroot
# as an *auto-root* pointing into $HOME — a separate volume the host's nix can't
# see, so a host-side `nix-collect-garbage` reads it as stale, drops it, and
# reclaims the tool paths out from under the container. Pin a direct root in the
# shared store instead.
#
# Name it per workspace: $USER is `coder` in every Coder workspace, so a shared
# name means each apply clobbers the previous workspace's pin and leaves that
# profile unprotected. `id -un` rather than $USER because set -u makes an unset
# $USER (docker exec, cron) a hard failure here.
if [ -n "$profile_after" ]; then
    gcdir="/nix/var/nix/gcroots/per-user/$(id -un)"
    mkdir -p "$gcdir" 2>/dev/null \
        && ln -sfn "$profile_after" "$gcdir/dotfiles-profile-{{ .chezmoi.hostname }}" \
        || echo "note: could not pin nix gcroot in shared store (host GC may reclaim tools)"
fi
{{- end }}
{{ end -}}
