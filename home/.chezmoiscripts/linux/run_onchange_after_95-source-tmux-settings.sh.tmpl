{{ if not .is_desktop -}}
#!/usr/bin/env bash

# .tmux.conf hash: {{ joinPath .chezmoi.homeDir ".tmux.conf" | include | sha256sum }}

# Reload the config into a running server so a live session picks up the
# change on apply. Plugins are fetched and pinned via .chezmoiexternal.toml
# (no tpm install step), so there is nothing to install here — the
# run-shell loads in .tmux.conf re-source the plugin files. With no server
# running, the config loads at the next tmux start and source-file would
# just error, so gate on an existing session.
if command -v tmux &> /dev/null && tmux has-session 2> /dev/null; then
    tmux source-file "$HOME/.tmux.conf"
fi
{{ end -}}
