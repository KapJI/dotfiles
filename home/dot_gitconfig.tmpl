{{- /* In an ephemeral container the account signer (1Password/op-ssh-sign) is absent.
       Auth and signing are separate problems there:
         - auth: Coder exports GIT_SSH_COMMAND="coder gitssh --", and that key is
           already registered on GitHub, so rewrite github.com to SSH and let it
           authenticate. HTTPS is not an option: the Coder external-auth token is
           read-only, so pushes over it 403.
         - signing: unix/before_04 fetches that same Coder key to disk (Coder
           otherwise keeps it in a temp file for one ssh call only) and it is
           registered on GitHub as a signing key, so sign with it. No key means
           signing stays off, so a keyless container still works. */ -}}
{{- $isc := index . "is_container" | default false -}}
{{- $ckey := joinPath .chezmoi.homeDir ".ssh/coder_gitssh_key.pub" -}}
{{- $hasckey := and $isc (stat $ckey) -}}
{{- $signdefault := and (not $isc) (ne (get .chezmoi.osRelease "id") "centos") -}}
[user]
    name = {{ .full_name }}
    email = {{ .git_email }}
    signingkey = {{ if $hasckey }}{{ $ckey }}{{ else }}{{ .git_signingkey }}{{ end }}
[push]
    default = simple
    autoSetupRemote = true
{{- if $isc }}
[url "git@github.com:"]
    insteadOf = https://github.com/
{{- end }}
[alias]
    # sync with zsh
    a = add
    b = branch
    c = commit
    co = checkout
    cl = clone
    cam = commit --all --message
    cm = commit --message
    d = diff
    ds = diff --staged
    f = fetch
    pl = pull
    plra = pull --rebase --autostash
    p = push
    r = remote
    rb = rebase
    rs = restore
    sh = show
    st = status
    sl = "log --graph --pretty=format:'commit: %C(bold red)%h%Creset %C(red)<%H>%Creset %C(bold magenta)%d %Creset%ndate: %C(bold yellow)%cd %Creset%C(yellow)%cr%Creset%nauthor: %C(bold blue)%an%Creset %C(blue)<%ae>%Creset%n%C(cyan)%s%n%Creset'"
    prev = "checkout HEAD^1"
    next = "!sh ~/bin/git-checkout-next.sh"
    fixup = "!sh ~/bin/git-fixup.sh"
    unstash = stash pop
    cleanup = "!sh ~/bin/git-branch-cleanup.sh"
    # hg compat
    amend = commit --all --amend
    histedit = rebase -i
    shelve = stash
    unshelve = stash pop
    uncommit = reset --soft HEAD^
    unamend = reset HEAD@{1}
    undo = reset --keep HEAD@{1}
    backout = revert
[color]
    ui = auto
[pull]
    rebase = true
[gpg]
    format = ssh
[gpg "ssh"]
    allowedSignersFile = ~/.ssh/allowed_signers
{{- if eq .osid "windows" }}
    program = C:/Windows/System32/OpenSSH/ssh-keygen.exe
{{- end }}
[commit]
    gpgsign = {{ if $hasckey }}true{{ else }}{{ $signdefault }}{{ end }}
[tag]
    forceSignAnnotated = {{ if $hasckey }}true{{ else }}{{ $signdefault }}{{ end }}
[init]
    defaultBranch = main
[core]
    pager = delta
{{- if eq .osid "windows" }}
    symlink = true
    sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
{{- end }}
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = default
    colorMovedWS = allow-indentation-change
[interactive]
    diffFilter = delta --color-only --pager less
[delta]
    # features:
    dark = true
    pager = "ov -F"
    side-by-side = true
    line-numbers = true
    # styles:
    file-modified-label = modified:
    hunk-header-decoration-style = yellow box
    hunk-header-style = syntax
    right-arrow = ->
    line-numbers-left-format = "{nm:>3}│"
    line-numbers-right-format = "{np:>3}│"
    line-numbers-zero-style = gray
    minus-emph-style = lemonchiffon crimson underline
    minus-empty-line-marker-style = normal maroon
    minus-style = syntax darkred
    plus-emph-style = lemonchiffon olivedrab underline
    plus-empty-line-marker-style = normal seagreen
    plus-style = syntax darkgreen
    whitespace-error-style = black white
    map-styles = "bold purple => syntax #33194d, bold cyan => syntax #4d2673"
[delta "interactive"]
    keep-plus-minus-markers = false
