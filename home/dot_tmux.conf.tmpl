{{- if and (eq .chezmoi.os "linux") (not .is_desktop) -}}
##### Basics #####

# Mouse for resize, scroll, select panes
set -g mouse on

# Required for imgcat
set -g allow-passthrough on

# History buffer (default ~2000)
set -g history-limit 50000

# Use tmux-256color for proper terminfo support
set -g default-terminal "tmux-256color"

# Advertise 24-bit colour to the outer terminal (truecolor in vim/nvim).
# terminal-features is tmux's modern interface for this, replacing the
# lower-level terminal-overrides. Recent terminfo already advertises RGB
# for *-256color, but this pins it regardless of the server's ncurses.
#
# Assign a fixed, high array slot rather than `set -as` (append): appending
# adds another identical entry on every source-file/reload, so the array
# grows without bound. An index well past the built-in features (there are
# only a handful) keeps this idempotent — a reload overwrites the same slot.
set -s 'terminal-features[100]' '*-256color*:RGB'

# Index windows/panes from 1
set -g base-index 1
setw -g pane-base-index 1

##### Window & session behaviour #####

# Renumber windows after closing
set -g renumber-windows on

# Per-pane window titles. Programs set OSC 2 → tmux updates each pane's
# `pane_title` independently. With `allow-rename off`, the OSC does NOT
# also rename the window directly. We then rename the window from the
# active pane's title via hooks fired on the relevant events:
#
#   pane-focus-in       — when a pane gains focus, take its title.
#   pane-title-changed  — when the ACTIVE pane's title changes, take
#                         it. Guarded on #{pane_active} so a title
#                         update in a background split doesn't
#                         clobber the window name.
#
# A pane's pane_title defaults to the hostname (non-empty), so a title
# equal to #{host} means the program hasn't set one — treat that (and a
# genuinely empty title) as "unset" and fall back to #{pane_current_command}.
#
# automatic-rename is left off because its internal re-evaluation is
# multi-second and doesn't fire on pane_title or focus changes — using
# it instead of these hooks produces a visible lag after `cd` and on
# split switches.
set -g allow-rename off
setw -g automatic-rename off

set-hook -g pane-focus-in {
  rename-window "#{?pane_title,#{?#{==:#{pane_title},#{host}},#{pane_current_command},#{pane_title}},#{pane_current_command}}"
}
set-hook -g pane-title-changed {
  if-shell -F "#{pane_active}" {
    rename-window "#{?pane_title,#{?#{==:#{pane_title},#{host}},#{pane_current_command},#{pane_title}},#{pane_current_command}}"
  }
}

# Set terminal title from active window
set -g set-titles on

# Compact outer-terminal title (wezterm tab name): a server glyph
# (nf-fa-server) + the short hostname. host_short strips the FQDN
# suffix (server.example.com → server). The glyph makes SSH'd tabs
# instantly scannable; window/pane detail stays in tmux's own status
# bar inside the pane rather than being repeated in the outer tab.
set -g set-titles-string ' #{host_short}'

# aggressive-resize: size each window to the session actively viewing it
# (the one where it is the current window), not the largest session it is
# merely attached to. Suits full-screen apps that handle SIGWINCH.
setw -g aggressive-resize on


##### Interaction & keys #####

# Send terminal focus in/out events
set -s focus-events on

# Use vi keys in copy mode
setw -g mode-keys vi

# Esc delay — pin the modern default (10ms) explicitly
set -s escape-time 10

# Time window for repeatable key bindings (ms)
set -g repeat-time 500


##### Status & notifications #####

# Refresh status line every 5s
set -g status-interval 5

# Duration of messages (ms)
set -g display-time 1000

# Duration of pane number overlay (ms)
set -g display-panes-time 1500

# Activity monitoring: log but no visual bell
set -g monitor-activity on
set -g visual-activity off
set -g bell-action none


##### Key bindings #####

# Split panes and open the same path
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"

# Open new window with the same path
bind c new-window -c "#{pane_current_path}"

# Toggle full screen mode
bind f resize-pane -Z

# Convert pane into a window
bind F break-pane \; display-message "Pane moved to a separate window"

# Toggle synchronize-panes — the format expands after the toggle, so it
# reports the resulting state rather than just "toggled".
bind S setw synchronize-panes \; display-message "synchronize-panes #{?synchronize-panes,on,off}"

# Copy mode
bind v copy-mode

# Mouse drag: keep tmux's default forwarding to mouse-aware programs
# (send-keys -M when the pane is already in copy-mode or the app turned on
# mouse tracking, #{mouse_any_flag}) but drop the default's copy-mode -M
# else-branch, so a plain drag at the shell prompt does NOT fall into copy
# mode. The previous blanket `unbind` removed the forwarding too, so drags
# never reached mouse apps (nvim mouse, htop, less, fzf).
bind -T root MouseDrag1Pane if -F '#{||:#{pane_in_mode},#{mouse_any_flag}}' 'send-keys -M'

# Announce tmux to the outer terminal (e.g. wezterm) via OSC user-var so
# Alt-hjkl gets forwarded to us through SSH/et. Symmetric to smart-splits.nvim's
# IS_NVIM signal. Requires `allow-passthrough on` (set above).
#
# Important: write directly to #{client_tty} (the wezterm-facing tty);
# `run-shell` captures stdout to tmux's message area, so without the redirect
# the OSC never leaves tmux. base64("true") = "dHJ1ZQ==" hard-coded for clarity.
# No client-detached hook: by the time it fires, the client tty is gone, and
# the staleness ("IS_TMUX=true sticks after detach") is acceptable per workflow.
set-hook -g client-attached 'run-shell -b "printf \"\\033]1337;SetUserVar=IS_TMUX=dHJ1ZQ==\\007\" > #{client_tty}"'

# Use Alt-hjkl to switch panes (compatible with smart-splits.nvim)
is_vim="ps -o state= -o comm= -t '#{pane_tty}' | grep -iqE '^[^TXZ ]+ +(\\S+/)?g?(view|l?n?vim?x?|fzf)(diff)?$'"
bind -n M-h if-shell "$is_vim" "send-keys M-h" "select-pane -L"
bind -n M-j if-shell "$is_vim" "send-keys M-j" "select-pane -D"
bind -n M-k if-shell "$is_vim" "send-keys M-k" "select-pane -U"
bind -n M-l if-shell "$is_vim" "send-keys M-l" "select-pane -R"

# Alt-Shift-HJKL to resize panes (forwards to nvim's smart-splits when active)
bind -n M-H if-shell "$is_vim" "send-keys M-H" "resize-pane -L 3"
bind -n M-J if-shell "$is_vim" "send-keys M-J" "resize-pane -D 3"
bind -n M-K if-shell "$is_vim" "send-keys M-K" "resize-pane -U 3"
bind -n M-L if-shell "$is_vim" "send-keys M-L" "resize-pane -R 3"

# Alt-i/o to switch windows (no wrap-around)
bind -n M-i if -F '#{?window_start_flag,,1}' 'previous-window'
bind -n M-o if -F '#{?window_end_flag,,1}'   'next-window'

# Vi-like selection in copy mode
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi V send -X select-line
bind -T copy-mode-vi M-v send -X rectangle-toggle
bind -T copy-mode-vi Home send -X start-of-line
bind -T copy-mode-vi End  send -X end-of-line

# Do not cancel copy mode after copy
bind -T copy-mode-vi y send -X copy-selection
bind -T copy-mode-vi MouseDragEnd1Pane send -X copy-selection

# Copy last command output — Alt-Y, the same key as the zsh widget of
# the same name (zsh/config.d/copy_last_output.zsh). In a vim/nvim pane
# forward Alt-Y to the app instead, like the M-hjkl bindings above.
#
# Navigation is by the shell's OSC 133 prompt marks (emitted by the iterm2
# shell-integration plugin: 133;A prompt start, 133;C output start), which
# tmux records — NOT by matching the ❯ glyph. So previous-prompt/-o land on
# real prompt/output boundaries, and output that itself contains a ❯ (a log
# line, a cat-ed file) can no longer mis-anchor the selection the way the old
# search-backward '❯' did. Whether a pane's shell actually emits those marks
# can't be read back from a capture-pane snapshot, so the shell advertises it
# per-pane via @osc133_capable (see zsh/config.d/tmux_osc133.zsh); a pane
# without it (a bare shell, a login shell without the plugin) is rejected up
# front, so Alt-Y reports "nothing to copy" instead of copying garbage.
bind -n M-Y if-shell "$is_vim" "send-keys M-Y" {
    # Only trust OSC 133 prompt-mark navigation when this pane's shell
    # advertised the capability via @osc133_capable (set per-pane by
    # zsh/config.d/tmux_osc133.zsh). Without it the ❯ glyphs on screen are
    # just PS1 text with no marks behind them — previous-prompt would no-op
    # and the selection would be garbage — so report cleanly instead.
    if-shell -F "#{@osc133_capable}" {
        # Route on whether the cursor sits on a finished ❯ prompt (idle) or
        # inside a running command's output. capture-pane pads the visible
        # region to full pane height with blank rows, so test only the
        # cursor's own row (anchored ^❯ so a mid-line ❯ in output can't
        # false-match).
        if-shell -b "tmux capture-pane -p -J -S '#{cursor_y}' -E '#{cursor_y}' | grep -q '^❯'" {
            # Idle at a finished prompt: copy the PREVIOUS command's output.
            # Require at least two prompt marks — a fresh or just-cleared
            # pane has only the current one, so there is nothing to copy.
            if-shell -b "tmux capture-pane -p -S - -J | awk '/^❯/{n++} END{exit !(n>=2)}'" {
                copy-mode
                # Step off the current (idle) prompt, then to the previous
                # command's output start. next-prompt returns to the idle
                # prompt's mark; two cursor-ups walk back over the blank
                # ADD_NEWLINE gap to that output's last line (our p10k prompt
                # occupies two rows with a blank line above it).
                send -X previous-prompt
                send -X previous-prompt -o
                send -X begin-selection
                send -X next-prompt
                send -X cursor-up
                send -X cursor-up
                send -X end-of-line
                send -X copy-pipe-and-cancel "tmux load-buffer -w -b lastcmd -"
                display-message 'Copied last command output'
            } {
                display-message 'Nothing to copy — no previous command'
            }
        } {
            # A command is running: copy its output so far, from the running
            # command's output start down to the bottom of the live text.
            if-shell -b "tmux capture-pane -p -S - -J | grep -q '^❯'" {
                copy-mode
                send -X end-of-line
                send -X begin-selection
                send -X previous-prompt -o
                send -X copy-pipe-and-cancel "tmux load-buffer -w -b lastcmd -"
                display-message 'Copied running command output'
            } {
                display-message 'No prompt marker found — nothing to copy'
            }
        }
    } {
        display-message 'Alt-Y: no OSC 133 prompt marks in this pane — nothing to copy'
    }
}

# Quickly jump between shell prompts — by OSC 133 marks, like Alt-Y above.
bind P copy-mode \; send -X previous-prompt
bind N copy-mode \; send -X next-prompt
bind -T copy-mode-vi P send -X previous-prompt
bind -T copy-mode-vi N send -X next-prompt

##### Theme #####

set -g @catppuccin_flavor 'mocha'
set -g @catppuccin_window_text "#W"
set -g @catppuccin_window_current_text "#W"
set -g @catppuccin_window_current_number "#I#{?window_zoomed_flag, ,}"
set -g @catppuccin_window_number_position "right"

# Default icon may break tmux statusline in older Windows Terminal versions.
# Uncomment to fix or better update Windows Terminal.
#set -g @catppuccin_host_icon " "

# Make status line pretty
set -g status-right-length 100
set -g status-left-length 100
set -g status-left "#{tmux_mode_indicator} "
set -g status-right "#{E:@catppuccin_status_user}"
set -ag status-right "#{E:@catppuccin_status_host}"
set -ag status-right "#{E:@catppuccin_status_session}"


##### Mode Indicator #####

set -g @mode_indicator_prefix_prompt " WAIT "
set -g @mode_indicator_copy_prompt " COPY "
set -g @mode_indicator_sync_prompt " SYNC "
set -g @mode_indicator_empty_prompt " TMUX "

# Dormant upstream (last release 2021), pure shell — fetched and pinned to
# a commit via .chezmoiexternal.toml (it publishes no tags) and loaded from
# ~/.tmux/plugins like catppuccin/resurrect/continuum. fingers and extrakto
# stay on the nix profile above because they need a compiled binary / a
# python+fzf runtime that nixpkgs builds; this one is just shell.
# Must run after status-left is set (it substitutes the
# #{tmux_mode_indicator} placeholder) and after the prompts above.
#
# Guarded on the file existing: a plain missing run-shell is silent at
# server start but errors `returned 127` on every source-file reload, so
# a missing archive degrades to a quiet warning instead. The if-shell is
# transparent when the plugin is present (verified the placeholder still
# substitutes identically to an unguarded load).
if-shell "test -r ~/.tmux/plugins/mode-indicator/mode_indicator.tmux" \
  "run-shell ~/.tmux/plugins/mode-indicator/mode_indicator.tmux" \
  "display-message 'tmux: mode-indicator not found'"


##### Extrakto #####

set -g @extrakto_clip_tool_run "tmux_osc52"
set -g @extrakto_filter_order "path word line all"
set -g @extrakto_grab_area "recent"

# Needs python3 + fzf at runtime, which the nixpkgs build wires up; loaded
# from the nix profile and pinned via flake.lock, like tmux-fingers.
# Guarded so a missing file warns quietly rather than erroring on every
# source-file reload.
if-shell "test -r ~/.nix-profile/share/tmux-plugins/extrakto/extrakto.tmux" \
  "run-shell ~/.nix-profile/share/tmux-plugins/extrakto/extrakto.tmux" \
  "display-message 'tmux: extrakto not found in nix profile'"


##### Fingers #####

set -g @fingers-key G
bind -n M-g run -b "#{@fingers-cli} start #{pane_id}"
# Jump-mode shortcut moved off M-j (which is pane-down) to M-y. Mnemonic: "yank".
bind -n M-y run -b "#{@fingers-cli} start #{pane_id} --mode jump"

# Load tmux-fingers from the nix-server profile (nixpkgs ships a pre-built
# binary + wrapper — no Crystal toolchain or RPATH gymnastics needed).
# Guarded like the other nix-loaded plugins above.
if-shell "test -r ~/.nix-profile/share/tmux-plugins/tmux-fingers/tmux-fingers.tmux" \
  "run-shell ~/.nix-profile/share/tmux-plugins/tmux-fingers/tmux-fingers.tmux" \
  "display-message 'tmux: tmux-fingers not found in nix profile'"


##### Resurrect & Continuum #####

# Continuum still auto-SAVES every 10 minutes (so a manual restore has
# something to restore). Auto-RESTORE is disabled — restore by hand
# with `prefix + C-r` (tmux-resurrect's default binding). Auto-restore
# fires during the initial client attach, and the resulting spawn
# flurry can interact badly with OSC user-var emissions reaching
# wezterm (see Alt-hjkl forwarding chain).
set -g @resurrect-capture-pane-contents 'on'
set -g @continuum-restore 'off'
set -g @continuum-save-interval '10'


##### Plugins #####

# Catppuccin, resurrect and continuum are fetched and pinned via
# .chezmoiexternal.toml (to release tags; mode-indicator above pins to a
# commit), then loaded here with the same guarded run-shell pattern. tpm is
# not used: its only jobs were cloning (chezmoi does that now) and sourcing
# these .tmux files, which each resolve their own directory self-relatively.
# The split with the nix-profile plugins is by build needs, not tags: every
# plugin that is just shell/config files lives in chezmoi, while fingers (a
# compiled binary) and extrakto (needs a python+fzf runtime) stay on nix,
# which builds and pins them via flake.lock.
#
# Load order matters: resurrect -> catppuccin -> continuum.
#  - resurrect before continuum: resurrect.tmux publishes the
#    @resurrect-{save,restore}-script-path options that continuum reads to
#    drive its auto-save, and continuum needs no tpm/env to find it.
#  - continuum LAST: continuum.tmux prepends its save hook,
#    #(continuum_save.sh), to status-right at load. Any plugin that rewrites
#    status-right afterwards drops that hook and silently stops the 10-minute
#    autosave — so it must run after catppuccin, which owns the status line.
if-shell "test -r ~/.tmux/plugins/tmux-resurrect/resurrect.tmux" \
  "run-shell ~/.tmux/plugins/tmux-resurrect/resurrect.tmux" \
  "display-message 'tmux: tmux-resurrect not found'"
if-shell "test -r ~/.tmux/plugins/catppuccin/catppuccin.tmux" \
  "run-shell ~/.tmux/plugins/catppuccin/catppuccin.tmux" \
  "display-message 'tmux: catppuccin not found'"
if-shell "test -r ~/.tmux/plugins/tmux-continuum/continuum.tmux" \
  "run-shell ~/.tmux/plugins/tmux-continuum/continuum.tmux" \
  "display-message 'tmux: tmux-continuum not found'"

# Override Catppuccin style for selected text
set -g mode-style "fg=#cdd6f4,bg=#585b70"

# Dim inactive panes
set -g window-style 'fg=#b7b9c5,bg=#24243a'
set -g window-active-style 'fg=#eeeeee,bg=#1e1e2e'
{{- end }}
