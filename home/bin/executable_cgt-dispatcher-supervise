#!/usr/bin/env bash

# Keep the CGT dispatcher's telegram_listener.py alive outside any Claude or
# herdr session, restarting it whenever it exits. The listener also syncs
# questions in its poll loop. The Coder template's startup_script starts this
# detached (setsid -f) on every workspace start; running it again is harmless.
#
# One Telegram poller only: the flock is inherited by the listener, so it stays
# held while the listener is alive, even if this script itself is killed. A
# second copy finds it taken and exits. A listener started any other way does
# not take it, so stop that one before the first launch.

set -u

dir=${CGT_DISPATCHER_DIR:-$HOME/.local/state/cgt-agents/dispatcher}
cd "$dir" || exit 1
exec 9>>supervisor.lock
flock -n 9 || exit 0

# The startup_script runs in a bare shell; python3 comes from the nix profile.
. /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh 2>/dev/null || true

log() { printf '%s %s\n' "$(date -Is)" "$*" >>supervisor.log; }
log "supervisor started (pid $$)"

while :; do
    python3 telegram_listener.py >>telegram-listener.log 2>&1
    log "telegram_listener.py exited ($?), restarting in 5s"
    sleep 5
done
