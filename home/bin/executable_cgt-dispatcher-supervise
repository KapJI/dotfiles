#!/usr/bin/env bash

# Deprecated. The agent-workflow services supervisor now owns the CGT Telegram
# listener (agent-workflow-services). This name stays only because the Coder
# template's startup_script still launches it: it forwards to that single,
# idempotent entry point, so it can never start a second Telegram poller or a
# separate question sync. Delete it once the template calls
# agent-workflow-services directly.

exec "$HOME/bin/agent-workflow-services" start
