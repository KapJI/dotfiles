encryption = "age"

[diff]
    pager = "delta"

[merge]
    command = "nvim"
    args = ["-d", "{{`{{ .Destination }}`}}", "{{`{{ .Source }}", "{{ .Target }}`}}"]

[data]
    {{- /* Ephemeral container (Coder workspace / CI): the workspace exports
           CHEZMOI_IS_CONTAINER; CODER_AGENT_TOKEN is a fallback for any Coder
           workspace. In a container we skip the interactive prompts and the
           gitHubKeys lookup below so `chezmoi init` never blocks; installer
           scripts, encrypted secrets, and commit signing are skipped elsewhere
           (see .chezmoiignore, dot_gitconfig). */ -}}
    {{- $is_container := or (ne (env "CHEZMOI_IS_CONTAINER") "") (ne (env "CODER_AGENT_TOKEN") "") -}}
    {{- $full_name := env "GIT_AUTHOR_NAME" -}}
    {{- $git_email := env "GIT_AUTHOR_EMAIL" -}}
    {{- if not $is_container -}}
    {{-   $full_name = promptStringOnce . "full_name" "Full name for Git" -}}
    {{-   $git_email = promptStringOnce . "git_email" "Email address for Git" -}}
    {{- end }}
    full_name = "{{ $full_name }}"
    git_email = "{{ $git_email }}"
    {{- /* The commit-signing key is the first SSH key on the GitHub account
           this repo was cloned from, so a fork signs with its owner's key. */ -}}
    {{- $git_signingkey := "" -}}
    {{- if not $is_container -}}
    {{-   $origin := output "git" "-C" .chezmoi.sourceDir "remote" "get-url" "origin" | trim | trimSuffix ".git" -}}
    {{-   $github_user := regexReplaceAll `^.*[:/]([^/]+)/[^/]+$` $origin "${1}" -}}
    {{-   $git_signingkey = (gitHubKeys $github_user | first).Key -}}
    {{- end }}
    git_signingkey = "{{ $git_signingkey }}"
    {{- $osid := .chezmoi.os -}}
    {{- if hasKey .chezmoi.osRelease "id" -}}
    {{-   $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
    {{- end }}
    osid = "{{ $osid }}"
    {{- $is_desktop := false -}}
    {{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "windows") -}}
    {{-   $is_desktop = true -}}
    {{- else if and (eq .chezmoi.os "linux") (not $is_container) -}}
    {{-   $is_desktop = promptBoolOnce . "is_desktop" "Is this a desktop machine (GUI)?" false -}}
    {{- end }}
    is_desktop = {{ $is_desktop }}
    is_container = {{ $is_container }}

[age]
    identity = "~/.config/chezmoi/key.txt"
    recipient = "age1p6n7pr73yfxysh8qjty4guhfea9gqgh7uwk8w6e3wx7r9eqqw4sqeg4r9g"

[gitHub]
    refreshPeriod = "24h"

{{- if eq .chezmoi.os "windows" }}

[cd]
    command = "pwsh.exe"

[interpreters.ps1]
    command = "powershell"
    args = ["-NoLogo", "-ExecutionPolicy", "RemoteSigned"]
{{- end }}
